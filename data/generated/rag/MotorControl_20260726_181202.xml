</Sections></Interface>
      <IsIECCheckEnabled>false</IsIECCheckEnabled>
      <MemoryLayout>Optimized</MemoryLayout>
      <Name>MotorControl</Name>
      <ProgrammingLanguage>LAD</ProgrammingLanguage>
      <SetENOAutomatically>false</SetENOAutomatically>
    </AttributeList>
    <ObjectList>
      <!-- 程序段1：起保停电路 — Start(NO) 和 Motor自锁(NO) 并联 → Stop(NC) 串联 → Motor(Coil) -->
      <SW.Blocks.CompileUnit ID="1" CompositionName="CompileUnits">
        <AttributeList>
          <NetworkSource><FlgNet xmlns="http://www.siemens.com/automation/Openness/SW/NetworkSource/FlgNet/v4">
  <Parts>
    <!-- PLC变量表标签：单 Component 引用 -->
    <Access Scope="GlobalVariable" UId="1">
      <Symbol><Component Name="Start" /></Symbol>
    </Access>
    <Access Scope="GlobalVariable" UId="2">
      <Symbol><Component Name="Motor" /></Symbol>
    </Access>
    <Access Scope="GlobalVariable" UId="3">
      <Symbol><Component Name="Stop" /></Symbol>
    </Access>
    <Access Scope="GlobalVariable" UId="4">
      <Symbol><Component Name="Motor" /></Symbol>
    </Access>
    <!-- 支路1：Start 常开触点 -->
    <Part Name="Contact" UId="10" />
    <!-- 支路2：Motor 常开触点（自锁） -->
    <Part Name="Contact" UId="11" />
    <!-- OR 功能块：合并两路并联 -->
    <Part Name="O" UId="12">
      <TemplateValue Name="Card" Type="Cardinality">2</TemplateValue>
    </Part>
    <!-- Stop 常闭触点 -->
    <Part Name="Contact" UId="13">
      <Negated Name="operand" />
    </Part>
    <!-- Motor 输出线圈 -->
    <Part Name="Coil" UId="14" />
  </Parts>
  <Wires>
    <!-- 并联起始：两条支路共用一条 Powerrail -->
    <Wire UId="20">
      <Powerrail />
      <NameCon UId="10" Name="in" />
      <NameCon UId="11" Name="in" />
    </Wire>
    <!-- 支路1 数据：Start → Contact(10) operand -->
    <Wire UId="21"><IdentCon UId="1" /><NameCon UId="10" Name="operand" /></Wire>
    <!-- 支路2 数据：Motor → Contact(11) operand -->
    <Wire UId="22"><IdentCon UId="2" /><NameCon UId="11" Name="operand" /></Wire>
    <!-- Start.out → O.in1 -->
    <Wire UId="23"><NameCon UId="10" Name="out" /><NameCon UId="12" Name="in1" /></Wire>
    <!-- Motor.out → O.in2 -->
    <Wire UId="24"><NameCon UId="11" Name="out" /><NameCon UId="12" Name="in2" /></Wire>
    <!-- O.out → Stop.in -->
    <Wire UId="25"><NameCon UId="12" Name="out" /><NameCon UId="13" Name="in" /></Wire>
    <!-- Stop operand 数据 -->
    <Wire UId="26"><IdentCon UId="3" /><NameCon UId="13" Name="operand" /></Wire>
    <!-- Stop.out → Motor_Coil.in -->
    <Wire UId="27"><NameCon UId="13" Name="out" /><NameCon UId="14" Name="in" /></Wire>
    <!-- Coil operand 数据 -->
    <Wire UId="28"><IdentCon UId="4" /><NameCon UId="14" Name="operand" /></Wire>
  </Wires>
</FlgNet></NetworkSource>
          <ProgrammingLanguage>LAD</ProgrammingLanguage>
        </AttributeList>
      </SW.Blocks.CompileUnit>
    </ObjectList>
