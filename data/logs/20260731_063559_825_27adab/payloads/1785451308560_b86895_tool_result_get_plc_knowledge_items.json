"meta=None content=[TextContent(type='text', text='{\"code\": \"OK\", \"data\": {\"items\": [{\"content\": \"<?xml version=\\\\\"1.0\\\\\" encoding=\\\\\"utf-8\\\\\"?>\\\\n<!-- verified_v17_sample: PLC块主体由Interface和CompileUnit集合构成；每个LAD Network通常是一个CompileUnit。 -->\\\\n<Document>\\\\n  <Engineering version=\\\\\"V17\\\\\" />\\\\n  <SW.Blocks.FC ID=\\\\\"0\\\\\">\\\\n    <AttributeList>\\\\n      <AutoNumber>true</AutoNumber>\\\\n      <Interface><Sections xmlns=\\\\\"http://www.siemens.com/automation/Openness/SW/Interface/v5\\\\\">\\\\n        <Section Name=\\\\\"Input\\\\\" /><Section Name=\\\\\"Output\\\\\" /><Section Name=\\\\\"InOut\\\\\" />\\\\n        <Section Name=\\\\\"Temp\\\\\" /><Section Name=\\\\\"Constant\\\\\" />\\\\n        <Section Name=\\\\\"Return\\\\\"><Member Name=\\\\\"Ret_Val\\\\\" Datatype=\\\\\"Void\\\\\" Accessibility=\\\\\"Public\\\\\" /></Section>\\\\n      </Sections></Interface>\\\\n      <MemoryLayout>Optimized</MemoryLayout><Name>FC_Name</Name><ProgrammingLanguage>LAD</ProgrammingLanguage>\\\\n    </AttributeList>\\\\n    <ObjectList>\\\\n      <SW.Blocks.CompileUnit ID=\\\\\"1\\\\\" CompositionName=\\\\\"CompileUnits\\\\\">\\\\n        <AttributeList>\\\\n          <NetworkSource><FlgNet xmlns=\\\\\"http://www.siemens.com/automation/Openness/SW/NetworkSource/FlgNet/v4\\\\\"><Parts /><Wires /></FlgNet></NetworkSource>\\\\n          <ProgrammingLanguage>LAD</ProgrammingLanguage>\\\\n        </AttributeList>\\\\n      </SW.Blocks.CompileUnit>\\\\n    </ObjectList>\\\\n  </SW.Blocks.FC>\\\\n</Document>\\\\n\", \"content_sha256\": \"c03cd711290a0388b55ec9e4e0222095eae6e95d116317f1d5a5de36e977ecb9\", \"id\": \"shell.fc_block.v17\", \"metadata\": {\"contains\": {\"access_scopes\": [], \"calls\": [], \"parts\": []}, \"content_path\": \"shells/fc_block_shell.xml\", \"content_type\": \"xml_fragment\", \"description\": \"最小FC块、Interface、ObjectList和单个LAD CompileUnit的层级。\", \"id\": \"shell.fc_block.v17\", \"intent\": [\"FC块\", \"块外壳\", \"CompileUn