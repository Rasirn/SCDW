e\\\\\" Type=\\\\\"Type\\\\\">Real</TemplateValue></Part>\\\\n    <Part Name=\\\\\"Coil\\\\\" UId=\\\\\"11\\\\\" />\\\\n  </Parts>\\\\n  <Wires>\\\\n    <Wire UId=\\\\\"20\\\\\"><Powerrail /><NameCon UId=\\\\\"10\\\\\" Name=\\\\\"pre\\\\\" /></Wire>\\\\n    <Wire UId=\\\\\"21\\\\\"><IdentCon UId=\\\\\"1\\\\\" /><NameCon UId=\\\\\"10\\\\\" Name=\\\\\"in1\\\\\" /></Wire>\\\\n    <Wire UId=\\\\\"22\\\\\"><IdentCon UId=\\\\\"2\\\\\" /><NameCon UId=\\\\\"10\\\\\" Name=\\\\\"in2\\\\\" /></Wire>\\\\n    <Wire UId=\\\\\"23\\\\\"><NameCon UId=\\\\\"10\\\\\" Name=\\\\\"out\\\\\" /><NameCon UId=\\\\\"11\\\\\" Name=\\\\\"in\\\\\" /></Wire>\\\\n    <Wire UId=\\\\\"24\\\\\"><IdentCon UId=\\\\\"3\\\\\" /><NameCon UId=\\\\\"11\\\\\" Name=\\\\\"operand\\\\\" /></Wire>\\\\n  </Wires>\\\\n</FlgNet>\\\\n\", \"content_sha256\": \"059c34d8b1d7f73adc6576e3ed39787ca8c32d1a7c1b36c4d2ae91e3f5bac66e\", \"id\": \"instruction.compare_ge_real_coil.v17\", \"metadata\": {\"contains\": {\"access_scopes\": [\"GlobalVariable\", \"LiteralConstant\"], \"calls\": [], \"parts\": [\"Ge\", \"Coil\"]}, \"content_path\": \"instructions/compare_ge_real_coil.xml\", \"content_type\": \"xml_fragment\", \"description\": \"真实生成案例经TIA V17导入和编译验证的Ge(REAL)到Coil完整Network。\", \"generation_mode\": \"knowledge_renderer_required\", \"id\": \"instruction.compare_ge_real_coil.v17\", \"intent\": [\"REAL大于等于\", \"Ge\", \"比较驱动线圈\"], \"not_for\": [\"并联OR条件\", \"不同数据类型混用\"], \"preserve\": [\"Ge SrcType=Real\", \"pre/in1/in2/out端口\", \"Ge到Coil的功率流\"], \"provides\": [\"compare.ge\", \"coil\", \"topology.series\"], \"replace\": [\"变量路径\", \"常量\", \"UId\"], \"requires\": [\"in1与in2均为Real\"], \"role\": \"instruction_pattern\", \"source_refs\": [\"data/rag/raw/generated_case/compare_ge_real_coil_v17.xml\", \"data/rag/raw/generated_case/compare_ge_real_coil_v17.compile.json\"], \"status\": \"verified\", \"tia_version\": \"V17\", \"title\": \"REAL大于等于比较驱动线圈\", \"topology\": [\"series\"]}}, {\"content\": \"<?xml version=\\\\\"1.0\\\\\" encoding=\\\\\"utf-8\\\\\"?>\\\\n<!-- verified_v17_sample: Network标题和功能注释位于CompileUnit的ObjectList，均保留完整MultilingualText层级。 -->\\\\n<SW.Blocks.CompileUnit ID=\\\\\"3\\\\\" CompositionName=\\\\\"CompileUnits\\\\\">\\\\n  <AttributeList>\\\\n    <NetworkSource><FlgNet xmlns=\\\\\"http://www.siemens.com/automation/Openness/SW/NetworkSource/FlgNet/v4\\\\\"><Parts /><Wires /></FlgNet></NetworkSource>\\\\n    <ProgrammingLanguage>LAD</ProgrammingLanguage>\\\\n  </AttributeList>\\\\n  <ObjectList>\\\\n    <MultilingualText ID=\\\\\"4\\\\\" CompositionName=\\\\\"Comment\\\\\"><ObjectList><MultilingualTextItem ID=\\\\\"5\\\\\" CompositionName=\\\\\"Items\\\\\"><AttributeList><Culture>zh-CN</Culture><Text>说明本Network的功能与边界。</Text></AttributeList></MultilingualTextItem></ObjectList></MultilingualText>\\\\n    <MultilingualText ID=\\\\\"6\\\\\" CompositionName=\\\\\"Title\\\\\"><ObjectList><MultilingualTextItem ID=\\\\\"7\\\\\" CompositionName=\\\\\"Items\\\\\"><AttributeList><Culture>zh-CN</Culture><Text>Network标题</Text></AttributeList></MultilingualTextItem></ObjectList></MultilingualText>\\\\n  </ObjectList>\\\\n</SW.Blocks.CompileUnit>\\\\n\", \"content_sha256\": \"aa2106859f411bb6e60c81171cb769cc8aeb1c7099c91441755cfb4bfb6f9771\", \"id\": \"network_text.title_comment.v17\", \"metadata\": {\"contains\": {\"access_scopes\": [], \"calls\": [], \"parts\": []}, \"content_path\": \"network_text/title_and_comment.xml\", \"content_type\": \"xml_fragment\", \"description\": \"CompileUnit下Title与Comment的完整MultilingualText结构。\", \"id\": \"network_text.title_comment.v17\", \"intent\": [\"Network标题\", \"功能注释\", \"多语言文本\"], \"not_for\": [\"块级注释\"], \"preserve\": [\"CompositionName\", \"ObjectList层级\"], \"provides\": [\"network_title\", \"network_comment\", \"multilingual_text\"], \"replace\": [\"文本\", \"Culture\", \"对象ID\"], \"requires\": [\"CompileUnit存在\"], \"role\": \"network_text_pattern\", \"source_refs\": [\"data/rag/raw/application/Main.xml\"], \"status\": \"golden\", \"tia_version\": \"V17\", \"title\": \"Network标题和功能注释\"}}, {\"content\": \"# SimaticML 块结构（V17）\\\\n\\\\n- `verified_v17_sample`：PLC 块主体包含 `Interface` 与 `ObjectList` 中的 `SW.Blocks.CompileUnit`；每个 LAD Network 通常对应一个 CompileUnit。\\\\n- `verified_v17_sample`：CompileUnit 的 `NetworkSource/FlgNet` 由 `Parts` 和 `Wires` 组成。Network 还应在自身 `ObjectList` 中包含 Title 和 Comment 的完整 `MultilingualText` 结构。\\\\n- `project_debug_experience`：导入成功只说明 XML 被 TIA 接受，不代表符号、类型和调用关系可编译；最终必须以 TIA V17 编译结果为准。\\\\n\", \"content_sha256\": \"87dfe9f683d57262cf7d2ea11d528f20b128dc64c8de3789ad297d2754f8c438\", \"id\": \"guide.simaticml_block_structure.v17\", \"metadata\": {\"content_path\": \"guides/simaticml_block_structure.md\", \"content_type\": \"rule_document\", \"description\": \"Interface、CompileUnit、FlgNet以及导入与编译边界。\", \"id\": \"guide.simaticml_block_structure.v17\", \"intent\": [\"块结构\", \"CompileUnit\"], \"not_for\": [], \"preserve\": [], \"provides\": [\"block_structure_rules\"], \"replace\": [], \"requires\": [], \"role\": \"rule_guide\", \"source_refs\": [\"data/rag/raw/application/Main.xml\", \"src/scdw/mcp/tools.py\"], \"status\": \"golden\", \"tia_version\": \"V17\", \"title\": \"SimaticML块结构规则\"}}, {\"content\": \"# UId 与引用规则\\\\n\\\\n- `verified_v17_sample`：statements、CallInfo 和 operands 使用 UId 作为当前 CompileUnit 内的引用键；样本在不同 CompileUnit 中重复使用相同 UId。\\\\n- `verified_v17_sample`：UId 不要求跨整个块连续，也不携带业务语义。\\\\n- `verified_v17_sample`：嵌套的数组下标 Access 没有 UId，只有最外层 Access 被 `IdentCon` 引用。\\\\n- `verified_v17_sample`：`IdentCon` 引用 Access；`NameCon` 引用 Part 或 Call，并使用该元素的实际端口名。\\\\n\", \"content_sha256\": \"fc56ed681f0f35733264951247a62f4183b97a5e3aeda30e06951cfbff58c3e3\", \"id\": \"guide.uid_reference_rules.v17\", \"metadata\": {\"content_path\": \"guides/uid_and_reference_rules.md\", \"content_type\": \"rule_document\", \"description\": \"CompileUnit内唯一性、嵌套Access和连接引用规则。\", \"id\": \"guide.uid_reference_rules.v17\", \"intent\": [\"UId\", \"IdentCon\", \"NameCon\"], \"not_for\": [], \"preserve\": [], \"provides\": [\"uid_rules\", \"reference_rules\"], \"replace\": [], \"requires\": [], \"role\": \"rule_guide\", \"source_refs\": [\"data/rag/raw/application/Main.xml\", \"data/rag/raw/basic/07_数组访问与IO标签.xml\"], \"status\": \"golden\", \"tia_version\": \"V17\", \"title\": \"UId与引用规则\"}}, {\"content\": \"# Part、Call 与 Wire 成组规则\\\\n\\\\n- `verified_v17_sample`：Access、Part/Call 与 Wire 共同构成可理解的 LAD 网络；不得只复制 Part。\\\\n- `verified_v17_sample`：分叉可在一条 Wire 中由一个上游端口连接多个下游端口；并联起始支路共享同一 Powerrail Wire。\\\\n- `project_debug_experience`：LAD 元素存在代码生成顺序约束，但不要把导出 XML 中偶然的 Wire 文本顺序解释成动作优先级。\\\\n\", \"content_sha256\": \"5d3f077901c0f9e4a1fe2014beb4fe5d0ea21d6efac8c04d9bd7992a75122300\", \"id\": \"guide.part_wire_coupling.v17\", \"metadata\": {\"content_path\": \"guides/part_wire_coupling.md\", \"content_type\": \"rule_document\", \"description\": \"Access、Part、Call、Wire不可拆分及拓扑注意事项。\", \"id\": \"guide.part_wire_coupling.v17\", \"intent\": [\"Parts\", \"Wires\", \"拓扑\"], \"not_for\": [], \"preserve\": [], \"provides\": [\"part_wire_rules\"], \"replace\": [], \"requires\": [], \"role\": \"rule_guide\", \"source_refs\": [\"data/rag/raw/basic/02_并联_多支路.xml\", \"src/scdw/mcp/tools.py\"], \"status\": \"golden\", \"tia_version\": \"V17\", \"title\": \"Part与Wire成组规则\"}}, {\"content\": \"# Interface 与 Access 一致性\\\\n\\\\n- `verified_v17_sample`：`Scope=\\\\\"LocalVariable\\\\\"` 的 Access 名称必须存在于当前块 Interface 的 Input、Output、InOut、Static 或 Temp 中。\\\\n- `verified_v17_sample`：FB 的状态保持数据和 IEC 定时器实例位于 Static；Input、Output、InOut 和 Temp 的 Section 语义不可互换。\\\\n- `project_debug_experience`：复制局部变量网络时要同时复制或重建所需 Interface 声明，并保持名称和数据类型一致。\\\\n\", \"content_sha256\": \"8be355f648fe7d92bce10520076712290c1d10284a3c723f24b5dc5806633de7\", \"id\": \"guide.interface_access_consistency.v17\", \"metadata\": {\"content_path\": \"guides/interface_access_consistency.md\", \"content_type\": \"rule_document\", \"description\": \"LocalVariable与各接口Section的一致性约束。\", \"id\": \"guide.interface_access_consistency.v17\", \"intent\": [\"Interface\", \"LocalVariable\"], \"not_for\": [], \"preserve\": [], \"provides\": [\"interface_rules\"], \"replace\": [], \"requires\": [], \"role\": \"rule_guide\", \"source_refs\": [\"data/rag/raw/application/烧嘴控制.xml\"], \"status\": \"golden\", \"tia_version\": \"V17\", \"title\": \"Interface与Access一致性规则\"}}, {\"content\": \"# 指令模板规则\\\\n\\\\n- `verified_v17_sample`：指令 Version 必须沿用适用于目标 PLC 的 V17 样本；原本没有 Version 的元素不要随意添加。\\\\n- `verified_v17_sample`：`TemplateValue Type=\\\\\"Cardinality\\\\\"` 表达端口数量，`Type=\\\\\"Type\\\\\"` 表达类型；名称和值随指令而异。\\\\n- `verified_v17_sample`：数学指令样本包含 `AutomaticTyped`；Calc 的公式使用 `Equation`，变量以 IN1、IN2 等端口名出现。\\\\n- `project_debug_experience`：不要把一种指令的 TemplateValue、AutomaticTyped 或 Version 机械套用到另一种指令。\\\\n\", \"content_sha256\": \"ba9ab204ee0fbc1911f82f6bf117777bae92b30c77b6b8ad60a216390de8b13b\", \"id\": \"guide.instruction_template_rules.v17\", \"metadata\": {\"content_path\": \"guides/instruction_template_rules.md\", \"content_type\": \"rule_document\", \"description\": \"Version、TemplateValue、AutomaticTyped与Equation使用边界。\", \"id\": \"guide.instruction_template_rules.v17\", \"intent\": [\"TemplateValue\", \"AutomaticTyped\", \"Equation\", \"Version\"], \"not_for\": [], \"preserve\": [], \"provides\": [\"instruction_template_rules\"], \"replace\": [], \"requires\": [], \"role\": \"rule_guide\", \"source_refs\": [\"data/rag/raw/application/程序发生器.xml\", \"data/rag/raw/application/输入信号转换块.xml\"], \"status\": \"golden\", \"tia_version\": \"V17\", \"title\": \"特殊指令模板规则\"}}]}, \"message\": \"completed\", \"needs_user_action\": false, \"retryable\": false, \"stage\": \"get_plc_knowledge_items\", \"success\": true}', annotations=None)] isError=False"