<?xml version="1.0" encoding="utf-8"?>
<!--
  基础示例 06：数学运算指令 — Mul / Calc / Convert
  =====================================================
  程序段1：Mul（乘法）— 手动频率 × 2.0 → 控制输出
  程序段2：Calc（公式计算）— (控制输出 / 满量程) × 码值范围 → 输出码值
  程序段3：Convert（类型转换）— Real → Int

  ★ TemplateValue Type 枚举合法值（极重要，错误会导致导入失败）：
  ┌──────────────────┬──────────────────────────────────────────┐
  │ Type="Cardinality"│ 用于 Card 参数（输入/输出数量），值为整数 │
  │ Type="Type"       │ 用于数据类型参数（SrcType/DestType等）    │
  │                   │ 合法值：Real, Int, DInt, Bool, Word...    │
  └──────────────────┴──────────────────────────────────────────┘
  ⛔ 非法值（会导致枚举约束错误）：
    Type="DataType"  Type="String"  Type="type"（大小写严格区分）

  ★ Mul 指令的类型参数用法（与 Convert 不同）：
    使用 <AutomaticTyped Name="SrcType" /> 而非 TemplateValue
    → TIA Portal 自动从连接的变量推断类型，不需要显式指定

  ★ Calc 指令的公式用法：
    使用 <Equation>公式</Equation> 子元素，而非 TemplateValue
    变量名必须用 IN1/IN2/IN3... 格式，大写

  ★ Convert 指令的类型参数：
    SrcType（源类型）和 DestType（目标类型）用 Type="Type"
    Name 大小写严格：SrcType / DestType（不是 src_type / dest_type）
-->
<Document>
  <Engineering version="V17" />
  <SW.Blocks.FC ID="0">
    <AttributeList>
      <AutoNumber>true</AutoNumber>
      <HeaderAuthor />
      <HeaderFamily />
      <HeaderName />
      <HeaderVersion>0.1</HeaderVersion>
      <Interface><Sections xmlns="http://www.siemens.com/automation/Openness/SW/Interface/v5">
  <Section Name="Input" />
  <Section Name="Output" />
  <Section Name="InOut" />
  <Section Name="Temp" />
  <Section Name="Constant" />
  <Section Name="Return">
    <Member Name="Ret_Val" Datatype="Void" Accessibility="Public" />
  </Section>
</Sections></Interface>
      <IsIECCheckEnabled>false</IsIECCheckEnabled>
      <MemoryLayout>Optimized</MemoryLayout>
      <Name>数学运算指令</Name>
      <ProgrammingLanguage>LAD</ProgrammingLanguage>
      <SetENOAutomatically>false</SetENOAutomatically>
    </AttributeList>
    <ObjectList>

      <!-- ═══════════════════════════════════════════════════════════
           程序段1：Mul 乘法
           逻辑：RunFlag=1 时，手动频率 × 2.0 → 控制输出
           Mul 引脚：en(in功率), eno(out功率), in1/in2...(数据输入), out(数据输出)
           ═══════════════════════════════════════════════════════════ -->
      <SW.Blocks.CompileUnit ID="1" CompositionName="CompileUnits">
        <AttributeList>
          <NetworkSource><FlgNet xmlns="http://www.siemens.com/automation/Openness/SW/NetworkSource/FlgNet/v4">
  <Parts>
    <Access Scope="GlobalVariable" UId="1">
      <Symbol><Component Name="DB1" /><Component Name="RunFlag" /></Symbol>
    </Access>
    <Access Scope="GlobalVariable" UId="2">
      <Symbol><Component Name="DB1" /><Component Name="ManualFreq" /></Symbol>
    </Access>
    <Access Scope="LiteralConstant" UId="3">
      <Constant><ConstantType>Real</ConstantType><ConstantValue>2.0</ConstantValue></Constant>
    </Access>
    <Access Scope="GlobalVariable" UId="4">
      <Symbol><Component Name="DB1" /><Component Name="CtrlOutput" /></Symbol>
    </Access>

    <Part Name="Contact" UId="10" />
    <!--
      Mul 指令：
      - Card=2 表示有 2 个输入引脚 (in1, in2)
      - AutomaticTyped 让 TIA Portal 从连接变量自动推断类型
        ⛔ 不要写 <TemplateValue Name="SrcType" Type="Type">Real</TemplateValue>
        ✅ 必须写 <AutomaticTyped Name="SrcType" />
    -->
    <Part Name="Mul" UId="11" DisabledENO="false">
      <TemplateValue Name="Card" Type="Cardinality">2</TemplateValue>
      <AutomaticTyped Name="SrcType" />
    </Part>
  </Parts>
  <Wires>
    <Wire UId="20"><Powerrail /><NameCon UId="10" Name="in" /></Wire>
    <Wire UId="21"><IdentCon UId="1" /><NameCon UId="10" Name="operand" /></Wire>
    <Wire UId="22"><NameCon UId="10" Name="out" /><NameCon UId="11" Name="en" /></Wire>
    <!-- 数据输入：IdentCon(变量) 在前，NameCon(引脚) 在后 -->
    <Wire UId="23"><IdentCon UId="2" /><NameCon UId="11" Name="in1" /></Wire>
    <Wire UId="24"><IdentCon UId="3" /><NameCon UId="11" Name="in2" /></Wire>
    <!-- 数据输出：NameCon(引脚) 在前，IdentCon(变量) 在后 -->
    <Wire UId="25"><NameCon UId="11" Name="out" /><IdentCon UId="4" /></Wire>
  </Wires>
</FlgNet></NetworkSource>
          <ProgrammingLanguage>LAD</ProgrammingLanguage>
        </AttributeList>
      </SW.Blocks.CompileUnit>

      <!-- ═══════════════════════════════════════════════════════════
           程序段2：Calc 公式计算
           逻辑：RunFlag=1 时，(CtrlOutput / FullScale) × CodeRange → OutputCode
           Calc 引脚：en, eno, in1/in2/.../inN, out
           ═══════════════════════════════════════════════════════════ -->
      <SW.Blocks.CompileUnit ID="2" CompositionName="CompileUnits">
        <AttributeList>
          <NetworkSource><FlgNet xmlns="http://www.siemens.com/automation/Openness/SW/NetworkSource/FlgNet/v4">
  <Parts>
    <Access Scope="GlobalVariable" UId="30">
      <Symbol><Component Name="DB1" /><Component Name="RunFlag" /></Symbol>
    </Access>
    <Access Scope="GlobalVariable" UId="31">
      <Symbol><Component Name="DB1" /><Component Name="CtrlOutput" /></Symbol>
    </Access>
    <Access Scope="LiteralConstant" UId="32">
      <Constant><ConstantType>Real</ConstantType><ConstantValue>100.0</ConstantValue></Constant>
    </Access>
    <Access Scope="LiteralConstant" UId="33">
      <Constant><ConstantType>Real</ConstantType><ConstantValue>27648.0</ConstantValue></Constant>
    </Access>
    <Access Scope="GlobalVariable" UId="34">
      <Symbol><Component Name="DB1" /><Component Name="OutputTrans" /></Symbol>
    </Access>

    <Part Name="Contact" UId="40" />
    <!--
      Calc 指令：
      - <Equation> 子元素写公式，变量用 IN1/IN2/IN3（大写，从1开始）
        ⛔ 不要写 <TemplateValue Name="Expression" Type="String">...
        ✅ 必须写 <Equation>公式</Equation>
      - Card=3 → 3个输入引脚 in1/in2/in3
      - SrcType 用 Type="Type"（注意大小写：SrcType，值首字母大写：Real）
    -->
    <Part Name="Calc" UId="41" DisabledENO="false">
      <Equation>(IN1/IN2)*IN3</Equation>
      <TemplateValue Name="Card" Type="Cardinality">3</TemplateValue>
      <TemplateValue Name="SrcType" Type="Type">Real</TemplateValue>
    </Part>
  </Parts>
  <Wires>
    <Wire UId="50"><Powerrail /><NameCon UId="40" Name="in" /></Wire>
    <Wire UId="51"><IdentCon UId="30" /><NameCon UId="40" Name="operand" /></Wire>
    <Wire UId="52"><NameCon UId="40" Name="out" /><NameCon UId="41" Name="en" /></Wire>
    <Wire UId="53"><IdentCon UId="31" /><NameCon UId="41" Name="in1" /></Wire>
    <Wire UId="54"><IdentCon UId="32" /><NameCon UId="41" Name="in2" /></Wire>
    <Wire UId="55"><IdentCon UId="33" /><NameCon UId="41" Name="in3" /></Wire>
    <Wire UId="56"><NameCon UId="41" Name="out" /><IdentCon UId="34" /></Wire>
  </Wires>
</FlgNet></NetworkSource>
          <ProgrammingLanguage>LAD</ProgrammingLanguage>
        </AttributeList>
      </SW.Blocks.CompileUnit>

      <!-- ═══════════════════════════════════════════════════════════
           程序段3：Convert 类型转换
           逻辑：RunFlag=1 时，Real值(OutputTrans) → Int(OutputCode)
           Convert 引脚：en, eno, in, out
           ═══════════════════════════════════════════════════════════ -->
      <SW.Blocks.CompileUnit ID="3" CompositionName="CompileUnits">
        <AttributeList>
          <NetworkSource><FlgNet xmlns="http://www.siemens.com/automation/Openness/SW/NetworkSource/FlgNet/v4">
  <Parts>
    <Access Scope="GlobalVariable" UId="60">
      <Symbol><Component Name="DB1" /><Component Name="RunFlag" /></Symbol>
    </Access>
    <Access Scope="GlobalVariable" UId="61">
      <Symbol><Component Name="DB1" /><Component Name="OutputTrans" /></Symbol>
    </Access>
    <Access Scope="GlobalVariable" UId="62">
      <Symbol><Component Name="DB1" /><Component Name="OutputCode" /></Symbol>
    </Access>

    <Part Name="Contact" UId="70" />
    <!--
      Convert 指令：
      - SrcType/DestType 用 Type="Type"（值首字母大写：Real, Int, DInt, Word...）
        ⛔ 错误写法：Type="DataType"、Name="src_type"（小写下划线）
        ✅ 正确写法：Type="Type"，Name="SrcType" / Name="DestType"（驼峰命名）
      - 链式转换时用 eno 连接下一个 Convert 的 en（见 风机燃气.xml 模板）
    -->
    <Part Name="Convert" UId="71" DisabledENO="false">
      <TemplateValue Name="SrcType" Type="Type">Real</TemplateValue>
      <TemplateValue Name="DestType" Type="Type">Int</TemplateValue>
    </Part>
  </Parts>
  <Wires>
    <Wire UId="80"><Powerrail /><NameCon UId="70" Name="in" /></Wire>
    <Wire UId="81"><IdentCon UId="60" /><NameCon UId="70" Name="operand" /></Wire>
    <Wire UId="82"><NameCon UId="70" Name="out" /><NameCon UId="71" Name="en" /></Wire>
    <!-- Convert 只有一个 in 和一个 out -->
    <Wire UId="83"><IdentCon UId="61" /><NameCon UId="71" Name="in" /></Wire>
    <Wire UId="84"><NameCon UId="71" Name="out" /><IdentCon UId="62" /></Wire>
    <!-- ENO 不接线（不使用 ENO 继续串联时可省略） -->
  </Wires>
</FlgNet></NetworkSource>
          <ProgrammingLanguage>LAD</ProgrammingLanguage>
        </AttributeList>
      </SW.Blocks.CompileUnit>

    </ObjectList>
  </SW.Blocks.FC>
</Document>
