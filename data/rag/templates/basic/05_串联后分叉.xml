<?xml version="1.0" encoding="utf-8"?>
<!--
  基础示例 05：串联后分叉 — 公共条件后多输出（One-Rung Fan-out）
  =====================================================
  梯形图语义：
    接通条件：FaultSignal(NC)  ←── 公共条件，只在 Powerrail Wire 中连一次
    ├─ 支路A: → RCoil(RunFlag)       当 FaultSignal 未激活，清除运行标志
    ├─ 支路B: → RCoil(AutoOutput)    同时清除自动输出
    └─ 支路C: → Coil(AlarmOutput)    同时置位报警输出

  这对应一句逻辑描述：
    "当出现故障时，复位运行标志、清除自动输出、激活报警"
  → 一句话 = 一个 CompileUnit（一个梯级）

  核心规则（从此模板可学到）：
  1. 公共条件只写一次（Contact A），其 out 引脚接多个下游元素的 in 引脚
     → 在同一条 Wire 中：<NameCon UId="A" Name="out" /> 连接多个 <NameCon Name="in" />
  2. 这与"并联支路（多 Powerrail）"不同：
       并联：各支路各自从 Powerrail 出发，互相独立
       串联后分叉：所有支路共享同一个先行条件，条件满足后才各自执行
  3. 每个输出线圈（Coil/RCoil/SCoil）需要各自独立的 Access 元素（不同 UId）
     即使变量名相同（见下面 UId=2 和 UId=5 都是 RunFlag）

  对应的 FC 设计原则（甲方要求）：
    - 一句逻辑描述 = 一个 CompileUnit
    - 每个 CompileUnit 只允许一个连接到左母线的起始触点（或起始条件）
    - 该起始点之后可以有任意数量的分叉输出
-->
<Document>
  <Engineering version="V17" />
  <SW.Blocks.FC ID="0">
    <AttributeList>
      <AutoNumber>true</AutoNumber>
      <HeaderAuthor />
      <HeaderFamily />
      <HeaderName />
      <HeaderVersion>0.1</HeaderVersion>
      <Interface><Sections xmlns="http://www.siemens.com/automation/Openness/SW/Interface/v5">
  <Section Name="Input" />
  <Section Name="Output" />
  <Section Name="InOut" />
  <Section Name="Temp" />
  <Section Name="Constant" />
  <Section Name="Return">
    <Member Name="Ret_Val" Datatype="Void" Accessibility="Public" />
  </Section>
</Sections></Interface>
      <IsIECCheckEnabled>false</IsIECCheckEnabled>
      <MemoryLayout>Optimized</MemoryLayout>
      <Name>串联后分叉</Name>
      <ProgrammingLanguage>LAD</ProgrammingLanguage>
      <SetENOAutomatically>false</SetENOAutomatically>
    </AttributeList>
    <ObjectList>

      <!-- ═══════════════════════════════════════════════════════════
           程序段1：公共故障条件 → 三路并行复位/输出
           对应一句逻辑：
             "风机故障反馈信号出现时，复位运行标志、复位自动输出、置位报警"
           ═══════════════════════════════════════════════════════════ -->
      <SW.Blocks.CompileUnit ID="1" CompositionName="CompileUnits">
        <AttributeList>
          <NetworkSource><FlgNet xmlns="http://www.siemens.com/automation/Openness/SW/NetworkSource/FlgNet/v4">
  <Parts>
    <!-- 公共条件变量 -->
    <Access Scope="GlobalVariable" UId="1">
      <Symbol>
        <Component Name="数字量信号" />
        <Component Name="风机故障反馈" />
      </Symbol>
    </Access>
    <!-- 各支路输出变量（同一变量多次输出时每次用独立 UId） -->
    <Access Scope="GlobalVariable" UId="2">
      <Symbol>
        <Component Name="内部数据" />
        <Component Name="风机运行标志" />
      </Symbol>
    </Access>
    <Access Scope="GlobalVariable" UId="3">
      <Symbol>
        <Component Name="内部数据" />
        <Component Name="自动输出" />
      </Symbol>
    </Access>
    <Access Scope="GlobalVariable" UId="4">
      <Symbol>
        <Component Name="报警数据" />
        <Component Name="风机故障报警" />
      </Symbol>
    </Access>

    <!-- 公共条件触点（常开，即故障=1时接通） -->
    <Part Name="Contact" UId="10" />

    <!-- 三个输出（支路A/B/C，Part 排列顺序：支路A→支路B→支路C） -->
    <Part Name="RCoil" UId="11" />   <!-- 支路A：复位运行标志 -->
    <Part Name="RCoil" UId="12" />   <!-- 支路B：复位自动输出 -->
    <Part Name="SCoil" UId="13" />   <!-- 支路C：置位故障报警 -->
  </Parts>
  <Wires>
    <!-- 左母线 → 公共条件触点 in（只连一次，这是"公共条件"的关键） -->
    <Wire UId="20"><Powerrail /><NameCon UId="10" Name="in" /></Wire>

    <!-- 公共条件的数据引脚 → 变量 -->
    <Wire UId="21"><IdentCon UId="1" /><NameCon UId="10" Name="operand" /></Wire>

    <!-- ★ 关键：公共条件的 out 引脚同时连接三个支路的 in 引脚（fan-out） -->
    <Wire UId="22">
      <NameCon UId="10" Name="out" />
      <NameCon UId="11" Name="in" />
      <NameCon UId="12" Name="in" />
      <NameCon UId="13" Name="in" />
    </Wire>

    <!-- 各支路的数据引脚 → 各自的变量 -->
    <Wire UId="23"><IdentCon UId="2" /><NameCon UId="11" Name="operand" /></Wire>
    <Wire UId="24"><IdentCon UId="3" /><NameCon UId="12" Name="operand" /></Wire>
    <Wire UId="25"><IdentCon UId="4" /><NameCon UId="13" Name="operand" /></Wire>
  </Wires>
</FlgNet></NetworkSource>
          <ProgrammingLanguage>LAD</ProgrammingLanguage>
        </AttributeList>
      </SW.Blocks.CompileUnit>

      <!-- ═══════════════════════════════════════════════════════════
           程序段2：另一句逻辑（串联条件后再分叉）
           逻辑：运行标志=1 AND PID控制=1 时，→ 输出自动频率 AND 启用变频器
           注意：公共条件可以是多个串联触点，分叉在最后一个串联触点之后
           ═══════════════════════════════════════════════════════════ -->
      <SW.Blocks.CompileUnit ID="2" CompositionName="CompileUnits">
        <AttributeList>
          <NetworkSource><FlgNet xmlns="http://www.siemens.com/automation/Openness/SW/NetworkSource/FlgNet/v4">
  <Parts>
    <!-- 串联条件1 -->
    <Access Scope="GlobalVariable" UId="30">
      <Symbol><Component Name="内部数据" /><Component Name="风机运行标志" /></Symbol>
    </Access>
    <!-- 串联条件2 -->
    <Access Scope="GlobalVariable" UId="31">
      <Symbol><Component Name="内部数据" /><Component Name="PID控制" /></Symbol>
    </Access>
    <!-- 输出变量（两路输出） -->
    <Access Scope="GlobalVariable" UId="32">
      <Symbol><Component Name="内部数据" /><Component Name="风机自动输出" /></Symbol>
    </Access>
    <Access Scope="GlobalVariable" UId="33">
      <Symbol><Component Name="内部数据" /><Component Name="变频器启用" /></Symbol>
    </Access>

    <!-- 两个串联触点 -->
    <Part Name="Contact" UId="40" />
    <Part Name="Contact" UId="41" />
    <!-- 两个分叉输出（紧跟在 Contact41 之后的两条分支） -->
    <Part Name="Coil" UId="42" />
    <Part Name="SCoil" UId="43" />
  </Parts>
  <Wires>
    <!-- 左母线 → 第一个串联触点 -->
    <Wire UId="50"><Powerrail /><NameCon UId="40" Name="in" /></Wire>
    <Wire UId="51"><IdentCon UId="30" /><NameCon UId="40" Name="operand" /></Wire>
    <!-- 串联：第一个触点 out → 第二个触点 in -->
    <Wire UId="52"><NameCon UId="40" Name="out" /><NameCon UId="41" Name="in" /></Wire>
    <Wire UId="53"><IdentCon UId="31" /><NameCon UId="41" Name="operand" /></Wire>
    <!-- ★ 最后一个串联触点的 out → 两个输出线圈的 in（fan-out） -->
    <Wire UId="54">
      <NameCon UId="41" Name="out" />
      <NameCon UId="42" Name="in" />
      <NameCon UId="43" Name="in" />
    </Wire>
    <Wire UId="55"><IdentCon UId="32" /><NameCon UId="42" Name="operand" /></Wire>
    <Wire UId="56"><IdentCon UId="33" /><NameCon UId="43" Name="operand" /></Wire>
  </Wires>
</FlgNet></NetworkSource>
          <ProgrammingLanguage>LAD</ProgrammingLanguage>
        </AttributeList>
      </SW.Blocks.CompileUnit>

    </ObjectList>
  </SW.Blocks.FC>
</Document>
